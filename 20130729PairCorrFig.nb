Cell[BoxData[
 RowBox[{
  RowBox[{"GammasSmall", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"GammasSorted", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"normSq", "[", "#", "]"}], "<", 
       RowBox[{"100", "^", "2"}]}], "&"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.584119502040316*^9, 3.584119512983527*^9}, {
  3.584119653696538*^9, 3.584119719686535*^9}, {3.584119878489766*^9, 
  3.584119896730486*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Length", "[", "GammasSmall", "]"}]], "Input",
 CellChangeTimes->{{3.584119681045353*^9, 3.584119695493449*^9}}],

Cell[BoxData["5554"], "Output",
 CellChangeTimes->{{3.58411969589288*^9, 3.584119728980193*^9}, {
  3.5841198883162394`*^9, 3.584119905041554*^9}}]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"normsSm", "=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"normSq", "/@", "GammasSmall"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"fconstSm", "=", 
  RowBox[{
   RowBox[{"Fit", "[", 
    RowBox[{"normsSm", ",", 
     RowBox[{"Sqrt", "[", "x", "]"}], ",", "x"}], "]"}], "/", 
   RowBox[{"Sqrt", "[", "x", "]"}]}]}]}], "Input",
 CellChangeTimes->{{3.5841197472775927`*^9, 3.584119767413497*^9}}],

Cell[BoxData["1.3162525660201272`"], "Output",
 CellChangeTimes->{
  3.584119773028199*^9, {3.584119891424562*^9, 3.5841199061456347`*^9}}]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ListPlot", "[", "normsSm", "]"}], ",", 
