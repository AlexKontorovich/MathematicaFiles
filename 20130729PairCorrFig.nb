Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Now", " ", "to", " ", "construct", " ", 
    RowBox[{"geodesics", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"geod", "[", 
      RowBox[{"z_", ",", "w_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "r", ",", "gt1", ",", "gt2", ",", "ans"}], "}"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Re", "[", "z", "]"}], "\[Equal]", 
           RowBox[{"Re", "[", "w", "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"vertical", " ", "geod"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ans", "=", 
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"CtoVect", "[", "z", "]"}], ",", 
               RowBox[{"CtoVect", "[", "w", "]"}]}], "}"}], "]"}]}], ";"}], 
          "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"otherwise", " ", "circle"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"x", "=", 
            FractionBox[
             RowBox[{
              RowBox[{
               RowBox[{"Abs", "[", "w", "]"}], "^", "2"}], "-", 
              RowBox[{
               RowBox[{"Abs", "[", "z", "]"}], "^", "2"}]}], 
             RowBox[{"2", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Re", "[", "w", "]"}], "-", 
                RowBox[{"Re", "[", "z", "]"}]}], ")"}]}]]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"r", "=", 
            FractionBox[
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"w", "-", "z"}], "]"}], " ", 
              RowBox[{"Abs", "[", 
               RowBox[{"w", "-", 
                RowBox[{"Conjugate", "[", "z", "]"}]}], "]"}]}], 
             RowBox[{"2", 
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"Re", "[", "w", "]"}], "-", 
                RowBox[{"Re", "[", "z", "]"}]}], "]"}]}]]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Re", "[", "z", "]"}], "\[NotEqual]", "x"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"gt1", "=", 
               RowBox[{"ArcTan", "[", 
                RowBox[{
                 RowBox[{"Im", "[", "z", "]"}], "/", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Re", "[", "z", "]"}], "-", "x"}], ")"}]}], 
                "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"gt1", "<", "0"}], ",", 
                RowBox[{"gt1", "+=", "Pi"}]}], "]"}], ";"}], 
             "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"gt1", "=", 
               RowBox[{"Pi", "/", "2"}]}], ";"}]}], "\[IndentingNewLine]", 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Re", "[", "w", "]"}], "\[NotEqual]", "x"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"gt2", "=", 
               RowBox[{"ArcTan", "[", 
                RowBox[{
                 RowBox[{"Im", "[", "w", "]"}], "/", 
                 RowBox[{"(", 
                  RowBox[{
