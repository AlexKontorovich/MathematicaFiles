Cell[BoxData[
 RowBox[{"(*", "\[IndentingNewLine]", "\t", 
  RowBox[{
  "We", " ", "now", " ", "construct", " ", "a", " ", "Dirichlet", " ", 
   "domain", " ", "corresponding", " ", "to", " ", "the", " ", "action", " ", 
   "of", " ", "the", " ", "above", " ", "matrices", " ", "on", " ", "some", 
   " ", "base", " ", "point"}], "\[IndentingNewLine]", "*)"}]], "Input",
 CellChangeTimes->{3.5260368589495153`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Pick", " ", "a", " ", "point"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"basept", "=", "I"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Action", " ", "of", " ", "SL", 
     RowBox[{"(", 
      RowBox[{"2", ",", "R"}], ")"}], " ", "on", " ", "H"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"zTogz", "[", 
      RowBox[{"z_", ",", "g_"}], "]"}], ":=", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"g", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}], "z"}], "+", 
           RowBox[{"g", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"g", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "1"}], "]"}], "]"}], "z"}], "+", 
           RowBox[{"g", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ")"}]}], "]"}], "+", 
       RowBox[{"I", "  ", 
        RowBox[{"Im", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}], "z"}], "+", 
            RowBox[{"g", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", "1"}], "]"}], "]"}], "z"}], "+", 
            RowBox[{"g", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ")"}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Going", " ", "between", " ", "C", " ", "and", " ", 
     RowBox[{"R", "^", "2"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"CtoVect", "[", "z_", "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Re", "[", "z", "]"}], ",", 
       RowBox[{"Im", "[", "z", "]"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"VectToC", "[", "p_", "]"}], ":=", 
     RowBox[{
      RowBox[{"p", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "+", 
      RowBox[{"I", " ", 
       RowBox[{"p", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Action", " ", "of", " ", "matrix", " ", "on", " ", "basept"}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"MatTimesBase", "[", "mat_", "]"}], ":=", 
     RowBox[{"zTogz", "[", 
      RowBox[{"basept", ",", "mat"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "This", " ", "is", " ", "the", " ", "orbit", " ", "of", " ", "Gammas", 
     " ", "found", " ", "above", " ", "on", " ", "basept"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"OrbitAll", "=", 
     RowBox[{"MatTimesBase", "/@", 
      RowBox[{"N", "[", "Gammas", "]"}]}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.5260366568717537`*^9, 3.526036864887587*^9}, {
   3.526036896904169*^9, 3.526036897080277*^9}, 3.526039261154283*^9, {
