Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "\[IndentingNewLine]", "\t", 
   RowBox[{
   "This", " ", "turns", " ", "solutions", " ", "into", " ", "matrices"}], 
   " ", "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"listToMat", "[", "list_", "]"}], ":=", "\[IndentingNewLine]", 
    RowBox[{"Simplify", "[", 
     RowBox[{"u", "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"aa", "->", 
         RowBox[{"list", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", 
        RowBox[{"bb", "\[Rule]", 
         RowBox[{"list", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ",", 
        RowBox[{"cc", "\[Rule]", 
         RowBox[{"list", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}], ",", 
        RowBox[{"dd", "\[Rule]", 
         RowBox[{"list", "[", 
          RowBox[{"[", "4", "]"}], "]"}]}]}], "}"}]}], "]"}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.526036326006761*^9, 3.526036357115074*^9}, {
  3.58409797099815*^9, 3.584097992796598*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", "\t", 
