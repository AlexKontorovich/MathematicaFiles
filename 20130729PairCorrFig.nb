      RowBox[{"a", "\[LessEqual]", 
       RowBox[{
        RowBox[{"Sqrt", "[", "X", "]"}], "/", "2"}]}], ",", 
      RowBox[{"a", "++"}], ",", "\[IndentingNewLine]", 
