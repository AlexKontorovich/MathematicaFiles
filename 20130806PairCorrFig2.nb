Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Vgam", "=", 
  RowBox[{
   RowBox[{"Pi", " ", 
    RowBox[{
     RowBox[{"Q", "^", "2"}], "/", "tot"}]}], "//", 
   "N"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"g2", "[", "xi_", "]"}], ":=", 
    RowBox[{
     RowBox[{"Vgam", " ", "/", 
      RowBox[{"(", 
       RowBox[{"2", "Pi"}], ")"}]}], 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"NumNormSqOv2s", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "2"}], "]"}], "]"}], " ", 
        RowBox[{"f", "[", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"ArcCosh", "[", 
            RowBox[{"NumNormSqOv2s", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "]"}], ",", 
          RowBox[{"xi", " ", "Vgam"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "NumNormSqOv2s", "]"}]}], "}"}]}], "]"}]}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Timing", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"g2ListTh", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"xi", ",", 
        RowBox[{"g2", "[", "xi", "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"xi", ",", "vep", ",", "maxXi", ",", "vep"}], "}"}]}], "]"}]}],
    ";"}], "\[IndentingNewLine]", "]"}]}], "Input",
 CellChangeTimes->{{3.584790375269518*^9, 3.584790423365513*^9}, {
