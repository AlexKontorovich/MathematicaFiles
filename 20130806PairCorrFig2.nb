Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{"Now", " ", "for", " ", "the", " ", "empirical", " ", "pic"}], " ", 
  "*)"}]], "Input",
 CellChangeTimes->{{3.5847913845178347`*^9, 3.584791389946718*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "construct", " ", "the", " ", "g_", "2", " ", "function", " ", "at", " ", 
    "a", " ", "few", " ", "sample", " ", "points"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"Timing", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numCounts", "=", 
     RowBox[{"Floor", "[", 
      RowBox[{"maxXi", "/", "vep"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"g2counts", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", "numCounts"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", "1"}], ",", 
      RowBox[{"i", "<", "tot"}], ",", 
      RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"j", "=", 
          RowBox[{"i", "+", "1"}]}], ",", 
         RowBox[{"j", "\[LessEqual]", "tot"}], ",", 
         RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"k", "=", 
           RowBox[{
            RowBox[{"Floor", "[", 
             RowBox[{
              RowBox[{"tot", "/", "vep"}], " ", 
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"angles", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "-", 
                RowBox[{"angles", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], "  ", "]"}]}], "   ", 
             "]"}], "+", "1"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"k", ">", "numCounts"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"j", "=", 
              RowBox[{"tot", "+", "1"}]}], ";"}], " ", 
            RowBox[{"(*", " ", 
             RowBox[{"kick", " ", "out"}], " ", "*)"}], "\[IndentingNewLine]",
             ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"g2counts", "[", 
               RowBox[{"[", "k", "]"}], "]"}], "++"}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
