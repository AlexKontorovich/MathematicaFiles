Cell[BoxData[{
 RowBox[{
  RowBox[{"vep", "=", "0.005"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"maxXi", "=", "5"}], ";"}]}], "Input",
 CellChangeTimes->{{3.5847914476765957`*^9, 3.584791452755418*^9}, {
   3.5847942564783783`*^9, 3.584794256878241*^9}, 3.5847951101406193`*^9, {
   3.584802115388254*^9, 3.584802115499877*^9}, {3.584802177226096*^9, 
   3.584802180443235*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"First", "  ", "the", " ", "theoretical", " ", "pic"}], " ", 
   "*)"}], " ", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"ell_", ",", "xi_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"2", "/", 
      RowBox[{"xi", "^", "2"}]}], " ", 
     RowBox[{"Piecewise", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Log", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Cosh", "[", "ell", "]"}], "+", 
              RowBox[{"Sinh", "[", "ell", "]"}]}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Cosh", "[", "ell", "]"}], "+", 
              RowBox[{"Sqrt", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Sinh", "[", "ell", "]"}], "^", "2"}], "-", 
                RowBox[{"xi", "^", "2"}]}], "]"}]}], ")"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"xi", "\[LessEqual]", 
           RowBox[{"2", 
            RowBox[{"Sinh", "[", 
             RowBox[{"ell", "/", "2"}], "]"}]}]}]}], "\[IndentingNewLine]", 
         "}"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Log", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Cosh", "[", "ell", "]"}], "+", 
              RowBox[{"Sinh", "[", "ell", "]"}]}], ")"}], 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{"xi", "^", "2"}]}], ")"}], "/", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Cosh", "[", "ell", "]"}], "+", 
                RowBox[{"Sqrt", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Sinh", "[", "ell", "]"}], "^", "2"}], "-", 
                  RowBox[{"xi", "^", "2"}]}], "]"}]}], ")"}], "^", "2"}]}]}], 
           "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"2", 
            RowBox[{"Sinh", "[", 
             RowBox[{"ell", "/", "2"}], "]"}]}], "<=", "xi", "<=", 
           RowBox[{"Sinh", "[", "ell", "]"}]}]}], "\[IndentingNewLine]", 
         "}"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"ell", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Sinh", "[", "ell", "]"}], "<=", "xi"}]}], 
         "\[IndentingNewLine]", "}"}]}], "\[IndentingNewLine]", "}"}], 
      "\[IndentingNewLine]", "]"}]}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.584790309128356*^9, 3.5847903596079903`*^9}, 
   3.5847904384469643`*^9, 3.5847907178715277`*^9, {3.584790796840506*^9, 
   3.584790797456192*^9}, {3.584790842638212*^9, 3.584790862830118*^9}, {
   3.584790985874879*^9, 3.58479099780091*^9}, {3.58479103071879*^9, 
   3.5847910438282223`*^9}, {3.584794270118013*^9, 3.5847942752397614`*^9}, 
