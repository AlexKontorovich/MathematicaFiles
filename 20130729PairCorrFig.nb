 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Main", " ", "param"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Q", "=", "1000"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"X", "=", 
    RowBox[{
     RowBox[{"Q", "^", "2"}], "/", "8"}]}], "  ", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"get", " ", "table"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"for", " ", "each", " ", "n", " ", "of", " ", "reps", " ", 
        RowBox[{"a", "^", "2"}]}], "+", 
       RowBox[{"d", "^", "2"}]}], "=", "n"}], ",", " ", 
     RowBox[{
      RowBox[{"with", " ", "0"}], "\[LessEqual]", " ", "d", "<", "a"}]}], " ",
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sumsq", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "X"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"a", "=", "0"}], ",", 
      RowBox[{"a", "\[LessEqual]", 
       RowBox[{"Sqrt", "[", "X", "]"}]}], ",", 
      RowBox[{"a", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"d", "=", 
          RowBox[{"a", "+", "1"}]}], ",", 
         RowBox[{"d", "\[LessEqual]", 
          RowBox[{"Sqrt", "[", "X", "]"}]}], ",", 
         RowBox[{"d", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"a", "^", "2"}], "+", 
              RowBox[{"d", "^", "2"}]}], "\[LessEqual]", "X"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"AppendTo", "[", 
              RowBox[{
               RowBox[{"sumsq", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"a", "^", "2"}], "+", 
                  RowBox[{"d", "^", "2"}]}], "]"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"a", ",", "d"}], "}"}]}], "]"}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
