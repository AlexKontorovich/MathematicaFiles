     RowBox[{"2", ",", "R"}], ")"}]}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Gammas", "=", 
     RowBox[{"listToMat", "/@", "normElts"}]}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{"Length", "[", "Gammas", "]"}]}]}]], "Input",
