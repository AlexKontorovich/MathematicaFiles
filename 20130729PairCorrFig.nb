Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TwoCoshDis", "[", 
    RowBox[{"z_", ",", "w_"}], "]"}], ":=", 
   RowBox[{"2", "+", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"z", "-", "w"}], "]"}], "^", "2"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Im", "[", "z", "]"}], " ", 
       RowBox[{"Im", "[", "w", "]"}]}], ")"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.584100613125586*^9, 3.58410067584794*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"TwoCoshDis", "[", 
     RowBox[{"I", ",", 
      RowBox[{"x", "+", 
       RowBox[{"I", " ", "y"}]}]}], "]"}], "\[Equal]", "q"}], ",", 
   RowBox[{"Assumptions", "\[Rule]", 
    RowBox[{
     RowBox[{"x", ">", "0"}], "&&", 
     RowBox[{"y", ">", "0"}]}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.584101032497114*^9, 3.5841010609204473`*^9}}],

